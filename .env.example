# Port Call configuration. Copy to .env and edit; docker compose and the scripts both read it.
#
#   cp .env.example .env && ./pc up
#
# Everything below has a working default for one laptop running one bot, with transcription on
# this machine. Nothing here sends meeting audio anywhere unless you set the cloud lines.

# ── who you are ──────────────────────────────────────────────────────────────────────────────
# The owner account inside the stack. Tokens are minted for this user, and transcripts belong to
# it: change the email later and earlier meetings stop being readable with the new tokens.
OWNER_NAME=Owner
OWNER_EMAIL=owner@port-call.local

# ── the stack ────────────────────────────────────────────────────────────────────────────────
# Names the containers (<project>-vexa-lite-1, <project>-postgres-1) and the volumes. Pick once.
COMPOSE_PROJECT_NAME=port-call
# The admin API token inside the container (not reachable from outside). Any string.
ADMIN_TOKEN=change-me-admin-token
# Host ports, all bound to 127.0.0.1 only: the gateway (the API), vexa's own UI, and a noVNC view
# of the bot's desktop for the one step a human must do by hand (signing the bot into Google).
VEXA_GW_PORT=8056
VEXA_UI_PORT=3056
VEXA_VNC_PORT=6080

# ── transcription ────────────────────────────────────────────────────────────────────────────
# Default: Whisper on this machine (stt_local.py, started by ./pc up). Needs whisper.cpp's
# `whisper-server` on PATH: macOS `brew install whisper-cpp`; elsewhere build whisper.cpp.
TRANSCRIPTION_SERVICE_URL=http://host.docker.internal:8177/v1/audio/transcriptions
TRANSCRIBE_ENABLED=true

# Meet audio is cut into utterances by Pipecat on this machine (pipecat_local.py): voice
# detection, one Whisper pass per utterance, Smart Turn for end of turn. Comment out to use the
# bot's built-in lane instead. Its Python environment is built by `./pc up` with uv, which it
# installs if the machine has none.
PIPECAT_URL=http://host.docker.internal:8179

# Alternative, cloud: near.ai. Meeting AUDIO leaves this machine. Set a key, enable the profile,
# and point TRANSCRIPTION_SERVICE_URL at http://near-shim:8001/v1/audio/transcriptions.
#NEAR_API_KEY=
#COMPOSE_PROFILES=transcribe

# ── recording ────────────────────────────────────────────────────────────────────────────────
# Off. On, every bot records the meeting's audio into the container; there is no store wired for
# it yet, so leave this alone unless you are adding one.
RECORDING_ENABLED=false

# ── voice ────────────────────────────────────────────────────────────────────────────────────
# piper (natural, bundled in the image) or espeak (robotic, zero dependencies).
TTS_ENGINE=piper
